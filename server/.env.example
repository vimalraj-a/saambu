PORT=8080
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=mongo_hack

# Vision role: every call that looks at a screenshot (NL script generation,
# change-request grounding, action-deciding, assertion judging).
# Default base URL is OpenRouter; fill in a confirmed multimodal model slug
# from https://openrouter.ai/models (search for a vision-capable Qwen3 model).
VISION_LLM_BASE_URL=https://openrouter.ai/api/v1
VISION_LLM_API_KEY=
VISION_LLM_MODEL=

# Coder role: text-only, used only to turn a verified execution trace into
# the final Playwright .spec.ts. Fill in Qwen3 Coder Flash's exact slug.
CODER_LLM_BASE_URL=https://openrouter.ai/api/v1
CODER_LLM_API_KEY=
CODER_LLM_MODEL=

# To swap either role to OpenAI directly instead of OpenRouter:
#   VISION_LLM_BASE_URL=https://api.openai.com/v1
#   VISION_LLM_API_KEY=sk-...
#   VISION_LLM_MODEL=gpt-4.1
# (same pattern for CODER_LLM_*)
